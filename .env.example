# Copy this file to .env and adjust values before running in production.

# Port the Express server listens on
PORT=3000

# Secret used to sign admin JWT sessions — change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# Default admin account created the first time the server starts
# (only used if no admin_users row exists yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kaasni@admin123
ADMIN_NAME=Kaasni Admin

# Shipping fee applied to every order, in rupees (set to 0 for free shipping)
SHIPPING_FEE=0
